                         └──────────┬──────────┘
                                    │
                                    ▼
                         ┌─────────────────────┐
                         │     GitLab CI       │
                         │                     │
                         │  Build / Test       │
                         │  Promotion          │
                         │  Deploy             │
                         └──────────┬──────────┘
                                    │
                                    ▼
                         ┌─────────────────────┐
                         │      cd-tools       │
                         │                     │
